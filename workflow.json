{
  "name": "tts-workflow",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const item = { ...$json };\nconst src = (item.text ?? '').trim();\n\nconst escaped = src\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;')\n  .replace(/'/g, '&apos;');\n\nconst withBreaks = escaped\n  .replace(/、/g, '、<break time=\"120ms\"/>')\n  .replace(/。/g, '。<break time=\"220ms\"/>')\n  .replace(/！/g, '！<break time=\"220ms\"/>')\n  .replace(/？/g, '？<break time=\"220ms\"/>')\n  .replace(/!/g, '!<break time=\"220ms\"/>')\n  .replace(/\\?/g, '?<break time=\"220ms\"/>');\n\nitem.ssml = `<speak><prosody rate=\"95%\" pitch=\"+0.5st\">${withBreaks}</prosody></speak>`;\n\nreturn [{ json: item }];"
      },
      "id": "tts_preprocess",
      "name": "tts_preprocess",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://texttospeech.googleapis.com/v1/text:synthesize",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{$env.GCP_TTS_API_KEY}}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "charset",
              "value": "utf-8"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"input\": {\n    \"ssml\": \"{{$json.ssml}}\"\n  },\n  \"voice\": {\n    \"languageCode\": \"ja-JP\",\n    \"name\": \"{{$node['Config'].json.ttsVoiceByRole?.[$json.role] ?? $node['Config'].json.ttsVoiceDefault ?? 'ja-JP-Neural2-B'}}\"\n  },\n  \"audioConfig\": {\n    \"audioEncoding\": \"MP3\",\n    \"speakingRate\": {{$node[\"Config\"].json.ttsSpeakingRate ?? 1.0}},\n    \"pitch\": {{$node[\"Config\"].json.ttsPitch ?? 0}},\n    \"volumeGainDb\": {{$node[\"Config\"].json.ttsVolumeGainDb ?? 0}}\n  }\n}\n",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "google音声生成(base64)",
      "name": "google音声生成(base64)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        760,
        300
      ]
    }
  ],
  "connections": {
    "tts_preprocess": {
      "main": [
        [
          {
            "node": "google音声生成(base64)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}